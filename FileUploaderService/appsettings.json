{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.Hosting.Lifetime": "Information"
    }
  },
  "SourceFolder": "/tmp/source",
  "SourceTableName": "UploadQueue_Server1",
  "FileExtension": ".wav",
  "ConcurrencyLimit": 5,
  "MssqlConnectionString": "Server=localhost;Database=FileTrackingDb;User Id=sa;Password=yourStrong(!)Password;TrustServerCertificate=True;",
  "Aws": {
    "BucketName": "my-target-bucket",
    "DestinationPrefix": "tenant1/",
    "CertificatePath": "/path/to/certificate.pem",
    "PrivateKeyPath": "/path/to/private_key.pem",
    "TokenRefreshMinutes": 55,
    "RoleArn": "arn:aws:iam::123456789012:role/MyRolesAnywhereRole",
    "ProfileArn": "arn:aws:rolesanywhere:region:account:profile/profile-id",
    "TrustAnchorArn": "arn:aws:rolesanywhere:region:account:trust-anchor/anchor-id",
    "Region": "us-east-1"
  }
}
